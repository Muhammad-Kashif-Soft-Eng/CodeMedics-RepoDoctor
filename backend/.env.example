# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit secrets.

# Express server port
PORT=3001

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/codemedics
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codemedics
MONGODB_URI=mongodb://127.0.0.1:27017/codemedics

# GitHub Personal Access Token (optional — raises API rate limit from 60 to 5000 req/hr)
# Required scope: public_repo (read-only)
# GITHUB_TOKEN=
